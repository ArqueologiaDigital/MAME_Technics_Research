+			osd_printf_error("KN5A| STRAND_EXIT MIDBYTE-REOPEN rx=%d site=%s ctx=%s t=%s\n",
+					m_rx_clock_count, site, machine().describe_context().c_str(),
+					machine().time().as_string());
+		}
+	}
+	else
+	{
+		m_i_wclose++;
+		if (m_rx_clock_count != 8)
+		{
+			m_i_wclose_mid++;
+			osd_printf_error("KN5A| STRAND_ENTRY rx=%d cp_tx=%d site=%s ctx=%s t=%s\n",
+					m_rx_clock_count, g_kn5a_cp_txcount, site,
+					machine().describe_context().c_str(), machine().time().as_string());
+		}
 	}
 }
+
+void tmp94c241_serial_device::device_stop()
+{
+	if (m_channel != 1)
+		return;
+
+	osd_printf_error("KN5A| ===== control-panel serial link summary (%s) =====\n",
+			g_kn5a_pre_mode ? "PRE (option A disabled)" : "option A");
+	osd_printf_error("KN5A| drop_ext        = %llu   <-- panel-clocked bits LOST; must be 0 under A\n", (unsigned long long)m_i_drop_ext);
+	osd_printf_error("KN5A| drop_int        = %llu   (/8 = %llu)\n", (unsigned long long)m_i_drop_int, (unsigned long long)(m_i_drop_int / 8));
+	osd_printf_error("KN5A| tx_bytes        = %llu   (CPU command bytes)\n", (unsigned long long)m_i_tx_bytes);
+	osd_printf_error("KN5A| cpanel_recv     = %llu   (bytes the panel assembled)\n", (unsigned long long)g_kn5a_cp_recv);
+	osd_printf_error("KN5A| PHANTOM ARITHMETIC drop_int/8 == tx_bytes == cpanel_recv : %s\n",
+			(m_i_drop_int / 8 == m_i_tx_bytes && m_i_tx_bytes == g_kn5a_cp_recv) ? "HOLDS" : "BROKEN");
+	osd_printf_error("KN5A| latch           = %llu   rise_ext = %llu   rx_final = %d\n",
+			(unsigned long long)m_i_latch, (unsigned long long)m_i_rise_ext, m_rx_clock_count);
+	osd_printf_error("KN5A| strand_entry    = %llu   (gate closed MID-BYTE)\n", (unsigned long long)m_i_wclose_mid);
+	osd_printf_error("KN5A| strand_exit_mid = %llu   (MIDBYTE-REOPEN)\n", (unsigned long long)m_i_wopen_mid);
+	osd_printf_error("KN5A| strand_exit_cln = %llu   (CLEAN reopen)\n", (unsigned long long)(m_i_wopen - m_i_wopen_mid));
+	osd_printf_error("KN5A| wopen/wclose    = %llu / %llu   wnop_open = %llu\n",
+			(unsigned long long)m_i_wopen, (unsigned long long)m_i_wclose, (unsigned long long)m_i_wnop_open);
+	osd_printf_error("KN5A| tmr_edges       = %llu   tmr_dead(free-run) = %llu\n",
+			(unsigned long long)m_i_tmr_edges, (unsigned long long)m_i_tmr_dead);
+	osd_printf_error("KN5A| bprime_calls    = %llu   bprime_FIRED = %llu   <-- must be 0 (else A incomplete)\n",
+			(unsigned long long)m_i_bp_calls, (unsigned long long)m_i_bp_fired);
+	osd_printf_error("KN5A| PHASE_HIST      =");
+	for (int i = 0; i <= 8; i++)
+		if (m_i_phase_hist[i])
+			osd_printf_error(" %d:%llu", i, (unsigned long long)m_i_phase_hist[i]);
+	osd_printf_error("\n");
+	osd_printf_error("KN5A| cp_edges        = %llu   cp_txbytes = %llu   cp_hold = %llu\n",
+			(unsigned long long)g_kn5a_cp_edges, (unsigned long long)g_kn5a_cp_txbytes, (unsigned long long)g_kn5a_cp_hold);
+	osd_printf_error("KN5A| cp_rearm        = %llu ticks (%llu us total)   max_rearm = %llu ticks (%llu us)\n",
+			(unsigned long long)g_kn5a_cp_rearm, (unsigned long long)(g_kn5a_cp_rearm * 4),
+			(unsigned long long)g_kn5a_cp_rearm_max, (unsigned long long)(g_kn5a_cp_rearm_max * 4));
+	osd_printf_error("KN5A| cp_qmax         = %llu   cp_busreq = %llu   cp_abandon = %llu\n",
+			(unsigned long long)g_kn5a_cp_qmax, (unsigned long long)g_kn5a_cp_busreq,
+			(unsigned long long)g_kn5a_cp_abandon);
+	osd_printf_error("KN5A| =================================================\n");
+}
