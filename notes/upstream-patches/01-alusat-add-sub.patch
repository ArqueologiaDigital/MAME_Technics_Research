From 2d308c77468a027acc5ec660ee22859dae315f67 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Sat, 11 Jul 2026 16:54:43 +0100
Subject: [PATCH] sharc: implement MODE1 ALUSAT in the DRC add/sub -- THE
 EFFECT-CHAIN DIVERGENCE IS FIXED

Root cause of the never-decaying reverb wash (5 diagnostic sessions + a 3-phase
workflow campaign): the KN7000 effects kernel runs with MODE1 ALUSAT set (BIT
SET MODE1 0x3000 at PM 0x8074 -- our old listing mis-annotated it as
IRPTEN+NESTM; NESTM is 0x800). The rec49-family triangle LFOs generate their
sweep by saturating adds + IF-AV increment-reflection. MAME's DRC compiled
Rn=Rx+Ry / Rn=Rx-Ry as plain wrapping UML_ADD/UML_SUB with no ALUSAT anywhere,
so each LFO phase degenerated into a permanent +-2^31 two-sample rail bounce
(onsets computed at t=0.216/0.648/1.080s after DSP start -- matching every
observed symptom: free-running, input-independent, never-decaying, identical
across effect types, 'all filter gains <1 yet it sustains'). The thrashing
phase words modulated the delay taps at fs/2, filling the chain with garbage
that no damped filter could drain. The interpreter already saturated correctly
(compute_add/compute_sub); the parallel-ALU add/sub in the fork's multifunction
MAC block did not -- fixed both. DRC fix: compute into a temp, capture COND_V
while flags are live, then clamp to 0x7FFFFFFF/0x80000000 (SAR^0x80000000)
when MODE1.ALUSAT and overflow, with AN/AZ corrected for the saturated value.

VERIFIED: idle boot is silent forever (the self-railing wash is gone); with
reverb ON a released note's tail now falls to true digital zero (+2s) instead
of sustaining 17s+; the REVERB toggle and the dry path are unchanged; DRC
performance ~76%. Eliminated on the way (workflows wf_c6d2e140-eec +
wf_08fbdf6e-df9): corrupted uploads (49,269 writes replayed bit-exact), the
40-bit-precision hypothesis (all recursions proven float32-stable), idle LFO
amplitude drift (measured stable +-0.64% over 272k ticks). KNOWN REMAINING
POLISH (separate, smaller): gain staging runs hot (clips during held notes)
and the tail ends in a hard cut ~1.2s post-release rather than a smooth
exponential -- next investigation targets.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/devices/cpu/sharc/sharcdrc.cpp | 34 ++++++++++++++++++++++++------
 src/devices/cpu/sharc/sharcops.hxx | 17 +++++++++++++--
 2 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/src/devices/cpu/sharc/sharcdrc.cpp b/src/devices/cpu/sharc/sharcdrc.cpp
index 90ebee5..9366ee9 100644
--- a/src/devices/cpu/sharc/sharcdrc.cpp
+++ b/src/devices/cpu/sharc/sharcdrc.cpp
@@ -4452,14 +4452,36 @@ void adsp21062_device::generate_compute(drcuml_block &block, compiler_state &com
 						return;
 
 					case 0x01:      // Rn = Rx + Ry
-						UML_ADD(block, REG(rn), REG(rx), REG(ry));
-						update_az_av_an_ac_fixed(block, desc, false);
-						return;
-
 					case 0x02:      // Rn = Rx - Ry
-						UML_SUB(block, REG(rn), REG(rx), REG(ry));
-						update_az_av_an_ac_fixed(block, desc, true);
+					{
+						// MODE1 ALUSAT: the hardware CLAMPS fixed-point ALU results on overflow
+						// (TRM B-6: +ve -> 0x7FFFFFFF, -ve -> 0x80000000) and the KN7000 effects
+						// kernel runs with ALUSAT set (BIT SET MODE1 0x3000 at PM 0x8074). The
+						// rec49-family triangle LFOs depend on saturate+IF-AV-reflect; with a
+						// plain wrapping add they degenerate into a permanent +-2^31 two-sample
+						// rail bounce -- the source of the never-decaying effect-chain garbage.
+						// (The interpreter's compute_add/compute_sub already saturate.)
+						const bool is_sub = (operation == 0x02);
+						if (is_sub)
+							UML_SUB(block, I6, REG(rx), REG(ry));
+						else
+							UML_ADD(block, I6, REG(rx), REG(ry));
+						UML_MOV(block, I7, 0);
+						UML_SETc(block, uml::COND_V, I7);              // capture overflow while flags are live
+						update_az_av_an_ac_fixed(block, desc, is_sub);
+						UML_MOV(block, REG(rn), I6);
+						uml::code_label const no_sat = compiler.labelnum++;
+						UML_TEST(block, MODE1, MODE1_ALUSAT);
+						UML_JMPc(block, uml::COND_Z, no_sat);
+						UML_TEST(block, I7, 1);
+						UML_JMPc(block, uml::COND_Z, no_sat);
+						UML_SAR(block, I6, I6, 31);
+						UML_XOR(block, REG(rn), I6, 0x80000000);       // wrapped<0 -> 0x7FFFFFFF else 0x80000000
+						if (AN_CALC_REQUIRED) UML_XOR(block, ASTAT_AN, ASTAT_AN, 1);   // AN = sign of the SATURATED value
+						if (AZ_CALC_REQUIRED) UML_MOV(block, ASTAT_AZ, 0);             // a saturated value is never zero
+						UML_LABEL(block, no_sat);
 						return;
+					}
 
 					case 0x05:      // Rn = Rx + Ry + CI
 						UML_CARRY(block, ASTAT_AC, 0);
diff --git a/src/devices/cpu/sharc/sharcops.hxx b/src/devices/cpu/sharc/sharcops.hxx
index f90d801..6b3bf7d 100644
--- a/src/devices/cpu/sharc/sharcops.hxx
+++ b/src/devices/cpu/sharc/sharcops.hxx
@@ -811,9 +811,22 @@ void adsp21062_device::COMPUTE(uint32_t opcode)
 					SET_FLAG_MN(REG(fm));
 
 				uint32_t r_alu;
-				if (alu == 0)      r_alu = REG(fxa) + REG(fya);
-				else if (alu == 1) r_alu = REG(fxa) - REG(fya);
+				bool alu_ov = false;
+				if (alu == 0)
+				{
+					r_alu = REG(fxa) + REG(fya);
+					alu_ov = (~(REG(fxa) ^ REG(fya)) & (REG(fxa) ^ r_alu)) >> 31;
+				}
+				else if (alu == 1)
+				{
+					r_alu = REG(fxa) - REG(fya);
+					alu_ov = ((REG(fxa) ^ REG(fya)) & (REG(fxa) ^ r_alu)) >> 31;
+				}
 				else               r_alu = uint32_t((int64_t(int32_t(REG(fxa))) + int64_t(int32_t(REG(fya)))) >> 1);
+				// MODE1 ALUSAT: clamp on overflow (matches compute_add/compute_sub; the KN7000
+				// effects kernel runs with saturation enabled).
+				if (alu_ov && (m_core->mode1 & MODE1_ALUSAT))
+					r_alu = (int32_t(r_alu) < 0) ? 0x7FFFFFFF : 0x80000000;
 				REG(fa) = r_alu;
 
 				CLEAR_ALU_FLAGS();
-- 
