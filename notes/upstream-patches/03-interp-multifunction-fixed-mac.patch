From 99e1f7ff9e16e94cddc0edfa01b4269868db22a6 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Sun, 19 Jul 2026 02:44:40 +0100
Subject: [PATCH 3/9] sharc: implement the multifunction fixed-point MAC forms
 in the interpreter

Implement the fixed-point multiplier/MAC multifunction blocks the interpreter
was missing (it threw 'multi-function opcode not implemented'):
- multiop 0x06, 0x08-0x12, 0x14-0x16: Rm/MRF = [MRF +/-] Rxm*Rym (SSF/SSFR)
  in parallel with an ALU add / sub / average on Rxa,Rya (TRM B-58ff). The
  parallel ALU honors MODE1.ALUSAT (clamp to 0x7FFFFFFF/0x80000000 on
  overflow), matching compute_add/compute_sub.
- multiop 0x20-0x2f: Rm = Rxm*Rym (SSFR) in parallel with the dual
  Ra = Rxa + Rya, Rs = Rxa - Rya.
All signed fractional, product aligned to 1.63; the Rm register result takes
MR1 (bits 63:32), matching the existing compute_mul_ssfr_* helpers.

These are the interpreter conformance references for the DRC's native
multifunction-MAC emission later in this series.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/devices/cpu/sharc/sharcops.hxx | 76 ++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/src/devices/cpu/sharc/sharcops.hxx b/src/devices/cpu/sharc/sharcops.hxx
index 6223b2f0d06..6b3bf7d4cb1 100644
--- a/src/devices/cpu/sharc/sharcops.hxx
+++ b/src/devices/cpu/sharc/sharcops.hxx
@@ -783,6 +783,82 @@ void adsp21062_device::COMPUTE(uint32_t opcode)
 				compute_mul_ssfr_sub(fm, fxm, fym, fa, fxa, fya);
 				break;
 
+			case 0x06:                                                      /* Rm = Rxm*Rym (SSFR),  Ra = (Rxa+Rya)/2 */
+			case 0x08: case 0x09: case 0x0a:                                /* MRF = MRF + Rxm*Rym (SSF),  ALU */
+			case 0x0c: case 0x0d: case 0x0e:                                /* Rm  = MRF + Rxm*Rym (SSFR), ALU */
+			case 0x10: case 0x11: case 0x12:                                /* MRF = MRF - Rxm*Rym (SSF),  ALU */
+			case 0x14: case 0x15: case 0x16:                                /* Rm  = MRF - Rxm*Rym (SSFR), ALU */
+			{
+				// Fixed-point multiplier/MAC in parallel with an ALU add/sub/avg. The multiop
+				// field groups as (multiop>>2): 1 = Rm=Rxm*Rym, 2 = MRF+=Rxm*Rym,
+				// 3 = Rm=MRF+Rxm*Rym, 4 = MRF-=Rxm*Rym, 5 = Rm=MRF-Rxm*Rym; and (multiop&3):
+				// 0 = add, 1 = sub, 2 = average. All signed fractional (product aligned to 1.63);
+				// the Rm result takes MR1 (bits 63:32), matching compute_mul_ssfr_* above.
+				const int grp = multiop >> 2;
+				const int alu = multiop & 3;
+				const int64_t p = int64_t(mul_32x32(int32_t(REG(fxm)), int32_t(REG(fym)))) << 1;
+
+				CLEAR_MULTIPLIER_FLAGS();
+				switch (grp)
+				{
+					case 1:  REG(fm)     = uint32_t(uint64_t(p) >> 32); break;                                  // Rm = Rxm*Rym
+					case 2:  m_core->mrf = uint64_t(int64_t(m_core->mrf) + p); break;                            // MRF += Rxm*Rym
+					case 3:  REG(fm)     = uint32_t(uint64_t(int64_t(m_core->mrf) + p) >> 32); break;            // Rm = MRF + Rxm*Rym
+					case 4:  m_core->mrf = uint64_t(int64_t(m_core->mrf) - p); break;                            // MRF -= Rxm*Rym
+					case 5:  REG(fm)     = uint32_t(uint64_t(int64_t(m_core->mrf) - p) >> 32); break;            // Rm = MRF - Rxm*Rym
+				}
+				if (grp != 2 && grp != 4)
+					SET_FLAG_MN(REG(fm));
+
+				uint32_t r_alu;
+				bool alu_ov = false;
+				if (alu == 0)
+				{
+					r_alu = REG(fxa) + REG(fya);
+					alu_ov = (~(REG(fxa) ^ REG(fya)) & (REG(fxa) ^ r_alu)) >> 31;
+				}
+				else if (alu == 1)
+				{
+					r_alu = REG(fxa) - REG(fya);
+					alu_ov = ((REG(fxa) ^ REG(fya)) & (REG(fxa) ^ r_alu)) >> 31;
+				}
+				else               r_alu = uint32_t((int64_t(int32_t(REG(fxa))) + int64_t(int32_t(REG(fya)))) >> 1);
+				// MODE1 ALUSAT: clamp on overflow (matches compute_add/compute_sub; the KN7000
+				// effects kernel runs with saturation enabled).
+				if (alu_ov && (m_core->mode1 & MODE1_ALUSAT))
+					r_alu = (int32_t(r_alu) < 0) ? 0x7FFFFFFF : 0x80000000;
+				REG(fa) = r_alu;
+
+				CLEAR_ALU_FLAGS();
+				SET_FLAG_AN(r_alu);
+				SET_FLAG_AZ(r_alu);
+				m_core->astat &= ~AF;
+				break;
+			}
+
+			case 0x20: case 0x21: case 0x22: case 0x23: case 0x24: case 0x25: case 0x26: case 0x27:
+			case 0x28: case 0x29: case 0x2a: case 0x2b: case 0x2c: case 0x2d: case 0x2e: case 0x2f:
+			{
+				/* Rm = Rxm*Rym (SSFR),  Ra = Rxa + Rya,  Rs = Rxa - Rya */
+				const int rs = (opcode >> 16) & 0xf;
+				const int64_t p = int64_t(mul_32x32(int32_t(REG(fxm)), int32_t(REG(fym)))) << 1;
+				const uint32_t r_add = REG(fxa) + REG(fya);
+				const uint32_t r_sub = REG(fxa) - REG(fya);
+
+				CLEAR_MULTIPLIER_FLAGS();
+				REG(fm) = uint32_t(uint64_t(p) >> 32);
+				SET_FLAG_MN(REG(fm));
+
+				CLEAR_ALU_FLAGS();
+				m_core->astat |= ((r_add == 0) || (r_sub == 0)) ? AZ : 0;
+				m_core->astat |= ((r_add | r_sub) & 0x80000000) ? AN : 0;
+				m_core->astat &= ~AF;
+
+				REG(fa) = r_add;
+				REG(rs) = r_sub;
+				break;
+			}
+
 			case 0x18:      /* Fm = Fxm * Fym,   Fa = Fxa + Fya */
 				compute_fmul_fadd(fm, fxm, fym, fa, fxa, fya);
 				break;
