From c377284f06c95785eef9f1e1245d65c97ce15ed9 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Tue, 17 Mar 2026 22:39:08 +0000
Subject: [PATCH 23/25] kn5000: Remove Feature Demo stuck-parts HLE workaround

Remove the timer that directly wrote to DRAM to clear stuck sequencer
parts. This was an HLE hack that bypassed the firmware's own sequencer
state machine, potentially causing the NAKA widget framework to enter
unexpected states.

The tone generator hold timer fix (voices properly time out without
waveform ROMs) and DSP ready signal fix (eliminating 8000-iteration
timeout loops) should allow the firmware to handle sequencer state
naturally.

(cherry picked from commit 67bb811e72c03cf21a25acc9ad4e12ac24e51365)
---
 src/mame/matsushita/kn5000.cpp | 100 +--------------------------------
 1 file changed, 1 insertion(+), 99 deletions(-)

diff --git a/src/mame/matsushita/kn5000.cpp b/src/mame/matsushita/kn5000.cpp
index e9f163f35ba..59081ab0a79 100644
--- a/src/mame/matsushita/kn5000.cpp
+++ b/src/mame/matsushita/kn5000.cpp
@@ -193,29 +193,6 @@ private:
 	// computed from the current DRAM state (same algorithm as the ROM handler).
 	// This ensures SubCPU_Payload_Verify passes on every boot.
 
-	// Feature Demo sequencer workaround (when waveform ROMs are missing)
-	//
-	// Without waveform ROMs, the accompaniment sequencer never fully starts
-	// playing, so 4 of 16 sequencer parts remain permanently active. The
-	// firmware's FDemo_MultiGuardCheck requires all parts to be idle
-	// (DRAM[0x10420] == 0) before the demo can advance to the next song/slide.
-	// This creates a deadlock: the demo can't advance because parts are stuck,
-	// and the parts can't clear because the demo hasn't advanced.
-	//
-	// On real hardware with waveform ROMs present, the sequencer runs the
-	// accompaniment patterns to completion and parts clear naturally. This
-	// workaround detects the stuck condition and force-clears the parts after
-	// a timeout, simulating normal song completion.
-	emu_timer *m_demo_workaround_timer;
-	uint16_t m_demo_prev_parts;
-	int m_demo_stuck_counter;
-	TIMER_CALLBACK_MEMBER(demo_workaround_check);
-
-	// DRAM addresses for Feature Demo state (byte offsets in maincpu DRAM)
-	static constexpr uint32_t DRAM_UI_STATE     = 0x008D38; // UI state byte (0xE4 = Feature Presentation)
-	static constexpr uint32_t DRAM_SEQ_PARTS    = 0x010420; // Sequencer part active flags (16 bits)
-	static constexpr uint32_t DRAM_DEMO_TIMER   = 0x000D2F; // Demo timer countdown
-
 	void nvram2_init(nvram_device &device, void *data, size_t size);
 	void maincpu_mem(address_map &map) ATTR_COLD;
 	void subcpu_mem(address_map &map) ATTR_COLD;
@@ -481,8 +458,6 @@ void kn5000_state::machine_start()
 	save_item(NAME(m_subcpu_latch_write_count));
 	save_item(NAME(m_maincpu_latch_write_count));
 	save_item(NAME(m_keybed_prev));
-	save_item(NAME(m_demo_prev_parts));
-	save_item(NAME(m_demo_stuck_counter));
 
 	m_extension->program_map(m_maincpu->space(AS_PROGRAM));
 
@@ -493,6 +468,7 @@ void kn5000_state::machine_start()
 	m_keybed_timer = timer_alloc(FUNC(kn5000_state::keybed_scan), this);
 	m_keybed_timer->adjust(attotime::from_msec(1), 0, attotime::from_msec(1));
 
+<<<<<<< HEAD
 	// SNS NMI emulation: intercept Boot_DisplayScreen's clearing of DRAM[0xFFD4]
 	// and substitute the correct payload checksums computed from current DRAM state.
 	// On real hardware, the NMI handler (EF08D4) computes these at power-off; we
@@ -523,17 +499,6 @@ void kn5000_state::machine_start()
 			}
 		});
 
-	// Feature Demo workaround: periodic check for stuck sequencer parts.
-	// Without fully functional waveform ROMs (IC304-IC306 are NO GOOD DUMP
-	// KNOWN), the accompaniment sequencer can't complete song playback,
-	// leaving parts permanently active. The workaround detects this specific
-	// stuck condition and force-clears the parts to unblock the demo.
-	// The condition checks are narrow enough (ui_state==0xE4, timer==0,
-	// parts unchanged for 3s) that this is safe even with waveform ROMs.
-	m_demo_prev_parts = 0;
-	m_demo_stuck_counter = 0;
-	m_demo_workaround_timer = timer_alloc(FUNC(kn5000_state::demo_workaround_check), this);
-	m_demo_workaround_timer->adjust(attotime::from_seconds(1), 0, attotime::from_seconds(1));
 }
 
 void kn5000_state::machine_reset()
@@ -544,72 +509,9 @@ void kn5000_state::machine_reset()
 	// Clear keybed state
 	std::fill(std::begin(m_keybed_prev), std::end(m_keybed_prev), 0);
 
-	// Reset demo workaround state
-	m_demo_prev_parts = 0;
-	m_demo_stuck_counter = 0;
 }
 
 
-TIMER_CALLBACK_MEMBER(kn5000_state::demo_workaround_check)
-{
-	// Feature Demo stuck-parts workaround (only active when waveform ROMs are missing).
-	//
-	// Without waveform ROMs (IC304-IC307, NO GOOD DUMP KNOWN), the accompaniment
-	// sequencer cannot complete song playback. This leaves 4 of 16 sequencer parts
-	// permanently active in DRAM[0x10420]. The firmware's FDemo_MultiGuardCheck
-	// requires this bitmask to be 0 before advancing the demo. On real hardware,
-	// the accompaniment patterns play to completion and parts clear naturally.
-	//
-	// Detection: UI state == 0xE4 (Feature Presentation), demo timer == 0 (song
-	// phase complete), parts non-zero and unchanged for 3+ consecutive checks (3s).
-	// Action: force-clear the sequencer parts bitmask to unblock the demo.
-
-	address_space &space = m_maincpu->space(AS_PROGRAM);
-
-	uint8_t ui_state = space.read_byte(DRAM_UI_STATE);
-	if (ui_state != 0xE4)
-	{
-		m_demo_stuck_counter = 0;
-		m_demo_prev_parts = 0;
-		return;
-	}
-
-	uint8_t demo_timer = space.read_byte(DRAM_DEMO_TIMER);
-	if (demo_timer != 0)
-	{
-		m_demo_stuck_counter = 0;
-		m_demo_prev_parts = 0;
-		return;
-	}
-
-	uint16_t parts = space.read_word(DRAM_SEQ_PARTS);
-	if (parts == 0)
-	{
-		// Parts already clear — nothing to do
-		m_demo_stuck_counter = 0;
-		m_demo_prev_parts = 0;
-		return;
-	}
-
-	if (parts == m_demo_prev_parts)
-	{
-		m_demo_stuck_counter++;
-		if (m_demo_stuck_counter >= 3)
-		{
-			// Parts have been stuck for 3+ seconds — force-clear
-			logerror("Feature Demo workaround: clearing stuck sequencer parts 0x%04X "
-				"(missing waveform ROMs)\n", parts);
-			space.write_word(DRAM_SEQ_PARTS, 0);
-			m_demo_stuck_counter = 0;
-			m_demo_prev_parts = 0;
-		}
-	}
-	else
-	{
-		m_demo_prev_parts = parts;
-		m_demo_stuck_counter = 1;
-	}
-}
 
 void kn5000_state::nvram2_init(nvram_device &device, void *data, size_t size)
 {
