From fc8e6de8d2af9599229b0f00b19e6fffb338d403 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Fri, 13 Mar 2026 19:29:02 +0000
Subject: [PATCH 02/25] tmp94c241: Fix 16-bit timer interrupt generation and
 flip-flop gating

Two bugs fixed in the timer_16bits lambda:

1. TREG_HIGH match was setting interrupt bit 0x08 (INTTR4/lower) instead
   of 0x80 (INTTR5/upper). Per the TMP94C241 datasheet, the HIGH register
   match generates the upper interrupt of the pair.

2. The TxFFCR flip-flop enable bits were gating the entire match condition,
   meaning the timer interrupt would never fire if the flip-flop output was
   disabled. Per the datasheet, the flip-flop control bits only gate the
   flip-flop toggle, not the counter match and interrupt generation.

Separate HIGH and LOW match into distinct branches: HIGH match resets the
counter and sets bit 0x80, LOW match sets bit 0x08 (no counter reset).

Tested: KN5000 firmware boots normally with correct LCD display.
---
 src/devices/cpu/tlcs900/tmp94c241.cpp | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/devices/cpu/tlcs900/tmp94c241.cpp b/src/devices/cpu/tlcs900/tmp94c241.cpp
index b5e537c9cee..dba66faabce 100644
--- a/src/devices/cpu/tlcs900/tmp94c241.cpp
+++ b/src/devices/cpu/tlcs900/tmp94c241.cpp
@@ -1467,6 +1467,9 @@ void tmp94c241_device::tlcs900_handle_timers()
 				    timer_id 6  =>  m_timer_16[1]  m_timer_change[5]
 				    timer_id 8  =>  m_timer_16[2]  m_timer_change[6]
 				    timer_id A  =>  m_timer_16[3]  m_timer_change[7]
+
+				    TREG_HIGH match generates the upper interrupt (e.g., INTTR5).
+				    TREG_LOW match generates the lower interrupt (e.g., INTTR4).
 				*/
 				uint8_t timer_index = (timer_id - 4)/2;
 
@@ -1474,11 +1477,18 @@ void tmp94c241_device::tlcs900_handle_timers()
 				{
 					m_timer_16[timer_index]++;
 					// TODO: also check for criteria of up counter matching CAPn registers
-					if (((m_timer_16[timer_index] == m_treg_16[timer_reg_high]) && BIT(tffcr, 3)) ||
-							((m_timer_16[timer_index] == m_treg_16[timer_reg_low]) && BIT(tffcr, 2)) )
+					if (m_timer_16[timer_index] == m_treg_16[timer_reg_high])
 					{
-						change_timer_flipflop(timer_id, FF_INVERT);
+						if (BIT(tffcr, 3))
+							change_timer_flipflop(timer_id, FF_INVERT);
 						m_timer_16[timer_index] = 0;
+						m_int_reg[interrupt] |= 0x80;
+						m_check_irqs = 1;
+					}
+					else if (m_timer_16[timer_index] == m_treg_16[timer_reg_low])
+					{
+						if (BIT(tffcr, 2))
+							change_timer_flipflop(timer_id, FF_INVERT);
 						m_int_reg[interrupt] |= 0x08;
 						m_check_irqs = 1;
 					}
