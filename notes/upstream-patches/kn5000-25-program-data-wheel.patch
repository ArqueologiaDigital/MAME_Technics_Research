From 9815c0bc579b4c05e1c9559192200cdb6de91893 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Mon, 20 Jul 2026 14:31:56 +0100
Subject: [PATCH 25/25] kn5000: Add Program data wheel encoder input

Wire the rotary encoder (data wheel / jog dial) next to the LCD. The left panel
MCU does not report it as a button scan column but as the segment 0x0B status
byte: bit 7 = clockwise, bit 6 = counter-clockwise. The firmware
(CPanel_ButtonPollLoop) reads that byte at STATE_OF_CPANEL_BUTTONS + 0x0B =
DRAM[0x8E55] and derives its encoder state 0x0D / 0x0E / 0x0C, from which it
generates the SetDialUp / SetDialDown navigation events.

The packet is pushed from the panel's own scan timer through the normal INTA
change notification, and a neutral 0x00 is sent when the wheel stops so the
firmware sees the transition back to idle.

The IPT_DIAL port is declared by the control panel device itself, alongside the
button matrix, and the layout knob is interactive (click and drag) with a
rotating dot pointer driven by a Lua bounds callback.

Squashed from the kn5000_research_datawheel branch (commits 122796d1b09 and
7c85d826302) and adapted to the device-owned input ports.
---
 src/mame/layout/kn5000.lay            | 48 +++++++++++++++++++-
 src/mame/matsushita/kn5000_cpanel.cpp | 64 ++++++++++++++++++++++++---
 src/mame/matsushita/kn5000_cpanel.h   |  6 +++
 3 files changed, 111 insertions(+), 7 deletions(-)

diff --git a/src/mame/layout/kn5000.lay b/src/mame/layout/kn5000.lay
index bbaf37f896e..c7d84a55446 100644
--- a/src/mame/layout/kn5000.lay
+++ b/src/mame/layout/kn5000.lay
@@ -768,7 +768,7 @@ license:CC0-1.0
 	<element ref="dark_37x21_button" inputtag="cpanel:CPL_SEG1" inputmask="0x08"><bounds x="332" y="477" width="37" height="21"/></element>
 	<element name="cpl_led_4" ref="green_led"><!-- SOUND ARRANGER: ON/OFF --><bounds x="348" y="469" width="5" height="5"/></element>
 
-	<element id="tempo_program_encoder" ref="tempo_encoder"><bounds x="591" y="460" width="91" height="91"/></element>
+	<element id="tempo_program_encoder" ref="tempo_encoder" inputtag="cpanel:ENCODER" inputmask="0xff" inputraw="yes"><bounds x="591" y="460" width="91" height="91"/></element>
 	<element id="tempo_program_encoder_finger" ref="tempo_encoder_finger"><bounds x="641" y="512" width="27" height="27"/></element>
 
 	<element ref="light_ellipse_button" inputtag="cpanel:CPL_SEG1" inputmask="0x10"><bounds x="444" y="455" width="81" height="23"/></element>
@@ -1334,4 +1334,50 @@ license:CC0-1.0
 		<bounds x="320" y="30" width="640" height="390"/>
 		<group ref="compact"><bounds x="0" y="0" width="1280" height="640"/></group>
 	</view>
+
+	<script><![CDATA[
+		-- Rotate the data wheel's finger grip according to the ENCODER port value.
+		-- The finger circle orbits the knob centre through a full 360 degrees.
+		local encoder_port = nil
+
+		file:set_resolve_tags_callback(function()
+			encoder_port = file.device:ioport("cpanel:ENCODER")
+			if not encoder_port then
+				emu.print_error("kn5000 layout: cpanel:ENCODER port not found")
+				return
+			end
+
+			for _, name in ipairs({"Full Unit", "Compact", "Screen close-up"}) do
+				local view = file.views[name]
+				if not view then goto continue end
+
+				local finger = view.items["tempo_program_encoder_finger"]
+				local knob = view.items["tempo_program_encoder"]
+				if not finger or not knob then goto continue end
+
+				local knob_b = knob.bounds
+				local finger_b = finger.bounds
+				local knob_cx = knob_b.x0 + knob_b.width / 2.0
+				local knob_cy = knob_b.y0 + knob_b.height / 2.0
+				local finger_w = finger_b.width
+				local finger_h = finger_b.height
+				local finger_cx = finger_b.x0 + finger_w / 2.0
+				local finger_cy = finger_b.y0 + finger_h / 2.0
+				local radius = math.sqrt((finger_cx - knob_cx)^2 + (finger_cy - knob_cy)^2)
+				local aspect = finger_b.aspect
+
+				finger:set_bounds_callback(function()
+					local val = encoder_port:read()
+					local angle = val / 255.0 * 2.0 * math.pi
+					local rx = radius * math.sin(angle) * aspect
+					local ry = -radius * math.cos(angle)
+					local x = knob_cx + rx - finger_w / 2.0
+					local y = knob_cy + ry - finger_h / 2.0
+					return emu.render_bounds(x, y, x + finger_w, y + finger_h)
+				end)
+
+				::continue::
+			end
+		end)
+	]]></script>
 </mamelayout>
diff --git a/src/mame/matsushita/kn5000_cpanel.cpp b/src/mame/matsushita/kn5000_cpanel.cpp
index 821b1989c9a..d2ccfb4161f 100644
--- a/src/mame/matsushita/kn5000_cpanel.cpp
+++ b/src/mame/matsushita/kn5000_cpanel.cpp
@@ -29,6 +29,7 @@
 #define LOG_SERIAL   (1U << 2)
 #define LOG_BUTTONS  (1U << 3)
 #define LOG_LEDS     (1U << 4)
+#define LOG_ENCODER  (1U << 5)
 
 #define VERBOSE 0
 #include "logmacro.h"
@@ -259,6 +260,11 @@ static INPUT_PORTS_START(kn5000_cpanel)
 	PORT_BIT( 0x20, IP_ACTIVE_HIGH, IPT_KEYBOARD ) PORT_NAME("UP 1")
 	PORT_BIT( 0x40, IP_ACTIVE_HIGH, IPT_KEYBOARD ) PORT_NAME("DOWN 2")
 	PORT_BIT( 0x80, IP_ACTIVE_HIGH, IPT_KEYBOARD ) PORT_NAME("UP 2")
+
+	// The "Program" data wheel (rotary encoder) sits next to the LCD and is read by the
+	// LEFT panel MCU, which reports its direction in the segment 0x0B status byte.
+	PORT_START("ENCODER")
+	PORT_BIT( 0xff, 0x00, IPT_DIAL ) PORT_NAME("Program data wheel") PORT_SENSITIVITY(25) PORT_KEYDELTA(5)
 INPUT_PORTS_END
 
 ioport_constructor kn5000_cpanel_device::device_input_ports() const
@@ -294,6 +300,9 @@ kn5000_cpanel_device::kn5000_cpanel_device(const machine_config &mconfig, const
 	m_inta_cb(*this),
 	m_cpl_ports(*this, "CPL_SEG%u", 0U),   // this device's own button ports (device_input_ports())
 	m_cpr_ports(*this, "CPR_SEG%u", 0U),
+	m_encoder_port(*this, "ENCODER"),
+	m_encoder_prev(0),
+	m_encoder_latch(0),
 	m_cpl_leds(*this, "cpl_led_%u", 0U),
 	m_cpr_leds(*this, "cpr_led_%u", 0U)
 {
@@ -331,6 +340,8 @@ void kn5000_cpanel_device::device_start()
 	save_item(NAME(m_self_clock_bytes_sent));
 	save_item(NAME(m_last_button_state));
 	save_item(NAME(m_pending_button_state));
+	save_item(NAME(m_encoder_prev));
+	save_item(NAME(m_encoder_latch));
 
 	// Initial state - line idle high
 	m_txd_cb(1);
@@ -751,6 +762,16 @@ uint8_t kn5000_cpanel_device::read_button_segment(int segment, bool is_left_pane
 	return (is_left_panel ? m_cpl_ports : m_cpr_ports)[segment].read_safe(0) & 0xff;
 }
 
+uint8_t kn5000_cpanel_device::read_status_register()
+{
+	// Segment 0x0B is a status register reported by the left panel MCU rather than a
+	// button scan column. The firmware (CPanel_ButtonPollLoop) reads it at
+	// STATE_OF_CPANEL_BUTTONS + 0x0B = DRAM[0x8E55] and derives the data wheel state
+	// 0x0D / 0x0E / 0x0C (up / down / idle) from bits 7 and 6:
+	//   bit 7 = wheel rotated clockwise, bit 6 = wheel rotated counter-clockwise.
+	return m_encoder_latch;
+}
+
 void kn5000_cpanel_device::send_button_packet(int segment, bool is_left_panel)
 {
 	// Button packet header: bits 7:6 = panel (00=right, 11=left),
@@ -758,7 +779,8 @@ void kn5000_cpanel_device::send_button_packet(int segment, bool is_left_panel)
 	// The firmware dispatches via a ROM lookup table that only maps
 	// bits 7:6=00 and bits 7:6=11 to valid event indices.
 
-	uint8_t state = read_button_segment(segment, is_left_panel);
+	uint8_t state = (segment == 0x0b) ? read_status_register()
+	                                  : read_button_segment(segment, is_left_panel);
 
 	uint8_t header = (segment & 0x0f);
 	if (is_left_panel)
@@ -770,10 +792,14 @@ void kn5000_cpanel_device::send_button_packet(int segment, bool is_left_panel)
 	LOGMASKED(LOG_BUTTONS, "Button packet: seg=%d left=%d state=%02X\n",
 		segment, is_left_panel, state);
 
-	// Track state for change detection
-	int state_idx = is_left_panel ? (segment + 11) : segment;
-	m_last_button_state[state_idx] = state;
-	m_pending_button_state[state_idx] = state;
+	// Track state for change detection (scan segments 0-10 only; segment 0x0B is the
+	// encoder status register and is tracked by m_encoder_latch instead).
+	if (segment <= 0x0a)
+	{
+		int state_idx = is_left_panel ? (segment + 11) : segment;
+		m_last_button_state[state_idx] = state;
+		m_pending_button_state[state_idx] = state;
+	}
 }
 
 void kn5000_cpanel_device::send_all_button_states(bool is_left_panel)
@@ -1100,9 +1126,35 @@ TIMER_CALLBACK_MEMBER(kn5000_cpanel_device::button_scan_callback)
 		}
 	}
 
+	// Scan the Program data wheel. The left panel MCU does not report it as a scan column
+	// but as the segment 0x0B status byte (bit 7 = clockwise, bit 6 = counter-clockwise),
+	// delivered through the same INTA change notification as the buttons.
+	if (m_encoder_port)
+	{
+		int32_t const pos = m_encoder_port->read();
+		int32_t const delta = pos - m_encoder_prev;
+		if (delta != 0)
+		{
+			m_encoder_prev = pos;
+			m_encoder_latch = (delta > 0) ? 0x80 : 0x40;
+			LOGMASKED(LOG_ENCODER, "data wheel %s (pos=%d delta=%d latch=0x%02X)\n",
+					(delta > 0) ? "CW" : "CCW", pos, delta, m_encoder_latch);
+			send_button_packet(0x0b, false);
+			changed = true;
+		}
+		else if (m_encoder_latch)
+		{
+			// The wheel stopped: report the neutral value so the firmware sees the
+			// transition back to its idle encoder state (0x0C).
+			m_encoder_latch = 0;
+			send_button_packet(0x0b, false);
+			changed = true;
+		}
+	}
+
 	if (changed)
 	{
-		LOGMASKED(LOG_BUTTONS, "confirmed button change, triggering INTA delivery\n");
+		LOGMASKED(LOG_BUTTONS, "confirmed button/data-wheel change, triggering INTA delivery\n");
 		m_idle_detect_timer->adjust(attotime::from_usec(50));
 	}
 }
