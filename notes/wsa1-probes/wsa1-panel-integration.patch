@@ in device_start(), beside the other save_item() calls
 	save_item(NAME(m_serial_control));
 	save_item(NAME(m_serial_mode));
+	save_item(NAME(m_sc1_rx_data));

@@ -1185,6 +1187,21 @@
 uint8_t tmp95c061_device::sc1buf_r()
 {
-	return 0;
+	// Whatever a connected device last handed us with sc1_rxd().  Still 0 for
+	// every machine that wires nothing: m_sc1_rx_data starts and stays 0.
+	return m_sc1_rx_data;
 }

 void tmp95c061_device::sc1buf_w(uint8_t data)
 {
 	// Fake finish sending data
 	m_int_reg[INTES1] |= 0x80;
 	m_check_irqs = 1;
+	m_sc1_txd_cb(data);
 }
+
+// One byte arriving on SC1 from a connected device.  INTES1 bit 3 is INTRX1's
+// request flag (tmp95c061_irq_vector_map[]: { INTES1, 0x08, 0x68 }), and
+// inte_w() refuses to set it from a register write, which is why this exists.
+void tmp95c061_device::sc1_rxd(uint8_t data)
+{
+	m_sc1_rx_data = data;
+	m_int_reg[INTES1] |= 0x08;
+	m_check_irqs = 1;
+}

