#include "wsa1_cpanel.h"

...in wsa1_state, beside the other required_device members:

+	required_device<wsa1_cpanel_device> m_cpanel;
+	uint8_t cpu1_p8_r();
+	uint8_t cpu1_pb_r();
+	uint8_t m_cpu1_p8 = 0;
+	uint8_t m_panel_sclk = 1;   // P8 bit 5, idle HIGH
+	uint8_t m_panel_busy = 0;   // PB bit 4, idle LOW
+	// 1 = SX-WSA1 keyboard, 2 = SX-WSA1R rack.  ONE constant drives both PB bit 0
+	// and the panel device, so the firmware's (0xC4) and the HLE's maps cannot
+	// disagree -- which is the whole failure mode this variable exists to prevent.
+	static constexpr uint8_t m_variant = 2;

...and in the constructor's initialiser list:  , m_cpanel(*this, "cpanel")

...two new port handlers.  BOTH LINE STATES MATTER: SC1_WaitTxDrain (prom_b
0xF5AB7B) and SC1_TxFlush_Body will not touch the link unless P8 bit 5 reads
HIGH *and* PB bit 4 reads LOW.  With MAME's unbound port read (0) the firmware
sees "line busy" forever, burns its 200 retries and transmits nothing at all --
no command, no LED frame.  That is the state the driver is in today.

+// P8CR = 0x09 / P8FC = 0x29 at RESET (0xF826D0-0xF826D3): bits 0 and 3 are the
+// TXD0 / TXD1 outputs, bit 5 is SCLK1 and the SC1 module switches it between an
+// output it drives low and a serial function (0xF5A977, 0xF5ADA1).  Read back it
+// is the state of the clock LINE, and idle is high.
+uint8_t wsa1_state::cpu1_p8_r()
+{
+	return (m_cpu1_p8 & 0xd7) | (m_panel_sclk ? 0x20 : 0x00);
+}
+
+// PBCR = 0x0C (0xF826E5): only bits 2 and 3 are outputs, so bits 0, 1, 4-7 are
+// inputs.  Two of them are known:
+//   bit 0  THE MODEL STRAP.  prom_a 0xF82882, called from RESET at 0xF827D8,
+//          is the only write to RAM (0xC4) in 512 KiB: high -> (0xC4)=1 (the
+//          SX-WSA1 keyboard's panel), low -> (0xC4)=2 (the SX-WSA1R rack's).
+//          109 sites branch on it, including both of the panel's own maps.
+//   bit 4  the panel MCU's busy line, tested with bit 5 of P8 above.
+uint8_t wsa1_state::cpu1_pb_r()
+{
+	uint8_t data = 0xef;                             // unwired bits read high
+	if (m_variant == 2) data &= ~0x01;               // PB.0 low  -> (0xC4) = 2
+	if (m_panel_busy)   data |=  0x10;
+	return data;
+}

