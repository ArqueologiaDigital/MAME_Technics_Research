		<element ref="lbl7"><!-- SX --><bounds x="919.447" y="58.564" width="14.668" height="12.067"/></element>
		<element ref="lbl8"><!--  --><bounds x="933.604" y="53.111" width="6.264" height="19.414"/></element>
