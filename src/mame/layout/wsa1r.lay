		<element ref="lbl19"><!-- PHONES --><bounds x="140.088" y="281.618" width="44.167" height="12.400"/></element>
		<element ref="lbl20"><!-- 1-6 --><bounds x="420.482" y="280.691" width="17.355" height="12.400"/></element>
		<element ref="lbl21"><!-- MAX --><bounds x="186.318" y="193.305" width="23.715" height="12.400"/></element>
