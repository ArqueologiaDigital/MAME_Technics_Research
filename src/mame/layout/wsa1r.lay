		<element ref="lbl25"><!-- USER 1 --><bounds x="1261.073" y="374.001" width="38.912" height="12.312"/></element>
		<element ref="lbl26"><!-- USER 2 --><bounds x="1316.071" y="374.001" width="39.000" height="12.312"/></element>
		<element ref="lbl27"><!-- ROM/EXT --><bounds x="1366.952" y="374.189" width="49.016" height="11.153"/></element>
		<element ref="lbl28"><!-- RE-MAP --><bounds x="1426.967" y="373.781" width="40.393" height="12.774"/></element>
		<element ref="lbl29"><!-- 1 --><bounds x="1276.734" y="414.781" width="7.328" height="12.774"/></element>
