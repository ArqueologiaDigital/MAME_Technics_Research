		<element ref="large_round_button" inputtag="cpanel:CP_SEG8" inputmask="0x01"><!-- SEG8/SW0  REALTIME CREATOR 1~6  [L] --><bounds x="411.283" y="297.009" width="37.232" height="37.253"/></element>
		<element ref="small_round_button" inputtag="cpanel:CP_SEG8" inputmask="0x02"><!-- SEG8/SW1  REALTIME CREATOR RESET  [L] --><bounds x="417.427" y="160.380" width="24.262" height="24.276"/></element>
		<element ref="lcd_soft_key" inputtag="cpanel:CP_SEG9" inputmask="0x01"><!-- SEG9/SW0  LCD soft key, LEFT column, 1st from top  [F] --><bounds x="492" y="100" width="35" height="31"/></element>
		<element ref="lcd_soft_key" inputtag="cpanel:CP_SEG9" inputmask="0x02"><!-- SEG9/SW1  LCD soft key, LEFT column, 2nd  [F] --><bounds x="492" y="142" width="35" height="31"/></element>
