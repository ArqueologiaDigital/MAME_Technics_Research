		<element name="led51" ref="wsa1_led_green"><!-- MIDI / NUMBER PAD (D131) ; reg6 bit3, the numeric family indicator --><bounds x="1124.300" y="68.300" width="6.400" height="6.400"/></element>
		<element ref="wsa1_led_red"><!-- UNBOUND: REALTIME CREATOR ring, top ; one of led16/17/24/25 - not decoded --><bounds x="318.300" y="143.300" width="6.400" height="6.400"/></element>
		<element ref="wsa1_led_red"><!-- UNBOUND: REALTIME CREATOR ring, right ; one of led16/17/24/25 - not decoded --><bounds x="410.300" y="236.300" width="6.400" height="6.400"/></element>
		<element ref="wsa1_led_red"><!-- UNBOUND: REALTIME CREATOR ring, bottom ; one of led16/17/24/25 - not decoded --><bounds x="318.300" y="329.300" width="6.400" height="6.400"/></element>
		<element ref="wsa1_led_red"><!-- UNBOUND: REALTIME CREATOR ring, left ; one of led16/17/24/25 - not decoded --><bounds x="224.300" y="236.300" width="6.400" height="6.400"/></element>
