		<element id="volume_knob" ref="volume_knob"><!-- VOLUME (wire 0xD3) --><bounds x="137.656" y="145.620" width="50.739" height="50.739"/></element>

		<element name="led8" ref="wsa1_led_green"><!-- PLAY MODE SOUND (D116) ; reg1 bit0 &lt;- SEG0/SW0 --><bounds x="1276.300" y="297.300" width="6.400" height="6.400"/></element>
		<element name="led9" ref="wsa1_led_green"><!-- PLAY MODE COMBI (D117) ; reg1 bit1 &lt;- SEG0/SW1 --><bounds x="1333.300" y="297.300" width="6.400" height="6.400"/></element>
		<element name="led10" ref="wsa1_led_green"><!-- EDIT MODE SOUND (D118) ; reg1 bit2 &lt;- SEG0/SW2 --><bounds x="1389.300" y="297.300" width="6.400" height="6.400"/></element>
		<element name="led11" ref="wsa1_led_green"><!-- EDIT MODE COMBI (D119) ; reg1 bit3 &lt;- SEG0/SW3 --><bounds x="1445.300" y="297.300" width="6.400" height="6.400"/></element>
		<element name="led0" ref="wsa1_led_red"><!-- BANK USER 1 (D120) ; reg0 bit0 &lt;- SEG0/SW4 --><bounds x="1276.300" y="364.300" width="6.400" height="6.400"/></element>
		<element name="led1" ref="wsa1_led_red"><!-- BANK USER 2 (D121) ; reg0 bit1 &lt;- SEG0/SW5 --><bounds x="1333.300" y="364.300" width="6.400" height="6.400"/></element>
		<element name="led2" ref="wsa1_led_red"><!-- BANK ROM/EXT (D122) ; reg0 bit2 &lt;- SEG0/SW6 --><bounds x="1389.300" y="364.300" width="6.400" height="6.400"/></element>
