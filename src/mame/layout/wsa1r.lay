		<element name="led32" ref="wsa1_led_green"><!-- MENU PART (D160) ; reg4 bit0 &lt;- SEG7/SW0 --><bounds x="263.300" y="77.300" width="6.400" height="6.400"/></element>
		<element name="led33" ref="wsa1_led_green"><!-- MENU SYSTEM (D161) ; reg4 bit1 &lt;- SEG7/SW1 --><bounds x="318.300" y="77.300" width="6.400" height="6.400"/></element>
