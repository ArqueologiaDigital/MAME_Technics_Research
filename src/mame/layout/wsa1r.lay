		<element ref="lbl32"><!-- COMBI --><bounds x="1317.399" y="306.001" width="35.652" height="12.312"/></element>
		<element ref="lbl33"><!-- SOUND --><bounds x="1260.294" y="306.001" width="39.339" height="12.312"/></element>
