		<element ref="lbl44"><!-- 4 --><bounds x="1320.540" y="133.846" width="5.988" height="12.400"/></element>
		<element ref="lbl45"><!-- 5 --><bounds x="1382.489" y="134.375" width="6.760" height="12.400"/></element>
		<element ref="lbl46"><!-- +1 --><bounds x="1210.837" y="87.781" width="16.175" height="12.774"/></element>
		<element ref="lbl47"><!-- -1 --><bounds x="1149.487" y="87.781" width="10.484" height="12.774"/></element>
		<element ref="lbl48"><!-- MIDI / NUMBER PAD --><bounds x="1135.130" y="65.786" width="87.393" height="12.748"/></element>
		<element ref="lbl49"><!-- COMBI --><bounds x="1429.399" y="306.001" width="35.652" height="12.312"/></element>
		<element ref="lbl50"><!-- SOUND --><bounds x="1372.294" y="306.001" width="39.339" height="12.312"/></element>
		<element ref="lbl51"><!-- EDIT --><bounds x="1385.894" y="277.751" width="25.996" height="13.851"/></element>
		<element ref="lbl52"><!-- MODE --><bounds x="1418.342" y="277.751" width="34.379" height="13.851"/></element>
		<element ref="lbl53"><!-- MODE --><bounds x="1307.949" y="277.902" width="34.779" height="13.665"/></element>
		<element ref="lbl54"><!-- PLAY --><bounds x="1273.881" y="277.626" width="27.356" height="13.665"/></element>
		<element ref="lbl55"><!-- BANK --><bounds x="1319.908" y="346.781" width="30.858" height="12.774"/></element>
		<element ref="lbl56"><!-- MAINCPU --><bounds x="25.961" y="471.001" width="48.960" height="12.312"/></element>
